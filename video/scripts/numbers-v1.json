{
  "version": "v1",
  "slug": "numbers",
  "story": "numbers",
  "title": "The Numbers",
  "fps": 30,
  "defaults": { "gap": 0.14, "sceneLead": 0.1, "sceneTail": 0.12 },
  "voices": {
    "N":     { "voice": "am_michael", "speed": 1.08 },
    "LEO":   { "voice": "af_bella",   "speed": 1.0,  "pitch": 1.08 },
    "ELLIE": { "voice": "af_heart",   "speed": 0.95, "pitch": 1.22 }
  },
  "scenes": [
    { "id": "crowd", "items": [
      { "say": "N", "text": "In this world, everyone has a number above their head." }
    ]},
    { "id": "lab", "items": [
      { "say": "N", "text": "Nobody knows what it means." }
    ]},
    { "id": "yard", "items": [
      { "say": "N", "text": "And you can see everyone's number... except your own.", "after": 0.25 }
    ]},
    { "id": "desk", "items": [
      { "say": "N", "text": "Leo wrote down every number he ever saw." },
      { "say": "N", "text": "His little sister, Ellie, was twenty-one." }
    ]},
    { "id": "walk", "items": [
      { "say": "N", "text": "So Leo made Ellie a promise." },
      { "say": "LEO", "text": "You'll never go anywhere alone. I'll always go first.", "after": 0.3 }
    ]},
    { "id": "street", "items": [
      { "say": "N", "text": "Then people started disappearing." },
      { "say": "N", "text": "The mailman. The bus driver. The crossing guard.",
        "cues": [ { "name": "despawn", "word": 1, "offset": -0.15 }, { "name": "despawn", "word": 4, "offset": -0.15 }, { "name": "despawn", "word": 7, "offset": -0.15 } ],
        "after": 0.35 }
    ]},
    { "id": "notebook", "items": [
      { "say": "N", "text": "Leo checked his notebook." },
      { "say": "N", "text": "Seventeen. Eighteen. Nineteen.",
        "cues": [ { "name": "scribble", "word": 0, "offset": -0.25 }, { "name": "scribble", "word": 1, "offset": -0.25 }, { "name": "scribble", "word": 2, "offset": -0.25 } ] },
      { "say": "N", "text": "They were disappearing in order." },
      { "say": "N", "text": "And after nineteen... came Ellie.", "cue": "circle", "cueAt": "end", "after": 0.3 }
    ]},
    { "id": "vigil", "ambience": "night", "items": [
      { "say": "N", "text": "That night, Leo held her hand and didn't sleep." },
      { "say": "ELLIE", "text": "Leo? Why is your number twenty?", "cue": "reveal", "cueAt": "end", "cueOffset": 0.2, "after": 0.0 },
      { "music": { "gain": 0.0, "fade": 0.3 } },
      { "pause": 0.5 },
      { "cue": "heartbeat" },
      { "pause": 1.3 },
      { "say": "N", "text": "Leo had never seen his own number." },
      { "say": "N", "text": "He was next.", "after": 0.3 }
    ]},
    { "id": "goodbye", "items": [
      { "say": "ELLIE", "text": "Don't go!" },
      { "say": "LEO", "text": "Hey. I promised. I always go first.", "cue": "despawn", "cueAt": "end", "cueOffset": 0.35, "after": 0.9 }
    ]},
    { "id": "turn", "items": [
      { "say": "N", "text": "The next morning, it was Ellie's turn.", "cue": "despawn", "cueAt": "end", "cueOffset": 0.25, "after": 0.7 }
    ]},
    { "id": "spawn", "lead": 0.0, "items": [
      { "cue": "spawn" },
      { "pause": 0.9 },
      { "say": "N", "text": "And somebody was waiting." },
      { "say": "LEO", "text": "Told you. You'll never go anywhere alone.", "after": 0.4 }
    ]},
    { "id": "ending", "items": [
      { "say": "N", "text": "Now Ellie knows what the numbers mean." },
      { "say": "N", "text": "It's the order we leave in... so nobody ever arrives alone.", "after": 1.1 }
    ]}
  ],
  "music": [
    { "scene": "crowd", "at": "start", "gain": 1.0, "section": "mystery" },
    { "scene": "street", "at": "start", "gain": 1.0, "section": "tense" },
    { "scene": "goodbye", "at": "start", "gain": 0.8, "fade": 1.0, "section": "sorrow" },
    { "scene": "spawn", "at": "start", "gain": 1.0, "fade": 1.5, "section": "hope" }
  ]
}
