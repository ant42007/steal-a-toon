    { "id": "town", "items": [
      { "say": "N", "text": "In this world, every lie you tell cracks your face." }
    ]},
    { "id": "teeth", "items": [
      { "say": "DAD", "text": "Did you brush your teeth?" },
      { "say": "KID", "text": "Totally!", "cue": "crack", "after": 0.55 }
    ]},
    { "id": "hallway", "items": [
      { "say": "N", "text": "Nobody lies. Except Lily's mom." },
      { "say": "N", "text": "Her face had more cracks than anyone in town." },
      { "say": "MOM", "text": "Rent's coming Friday, I promise!", "cue": "crack", "after": 0.45 }
    ]},
    { "id": "store", "items": [
      { "say": "MOM", "text": "I'll pay you back tomorrow.", "cue": "crack", "after": 0.45 }
