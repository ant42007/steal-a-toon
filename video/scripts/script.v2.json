    { "id": "school", "items": [
      { "say": "N", "text": "At school, they called Lily the liar's kid." },
      { "say": "N", "text": "So Lily swore she'd never tell a single lie." }
    ]},
    { "id": "dinner", "items": [
      { "say": "N", "text": "And every night, her mom said the same thing." },
      { "say": "MOM", "text": "Eat, baby. I already ate.", "cue": "tick", "after": 0.45 }
    ]},
    { "id": "hospital", "ambience": "monitor", "items": [
      { "say": "N", "text": "Then one day, her mom collapsed." },
      { "say": "DOCTOR", "text": "One more crack, and she won't wake up." },
      { "say": "LILY", "text": "Then stop lying!", "after": 0.0 },
      { "music": { "gain": 0.0, "fade": 0.35 } },
      { "pause": 1.3 }
    ]},
    { "id": "fridge", "ambience": "hum", "lead": 0.0, "items": [
      { "pause": 0.55 },
      { "cue": "fridgeOpen" },
      { "pause": 1.25 },
      { "say": "N", "text": "Empty." },
      { "pause": 0.25 },
      { "say": "N", "text": "It had been empty for months." }
    ]},
    { "id": "goldface", "items": [
      { "say": "N", "text": "Every lie her mom ever told... was so Lily could eat.", "cue": "goldStart", "cueAt": "start" },
      { "say": "MOM", "text": "I already ate.", "fx": "echo", "after": 0.3 }
    ]},
    { "id": "lastdinner", "items": [
      { "say": "N", "text": "The next night, there was one plate." },
      { "say": "MOM", "text": "Eat, baby. I already", "display": "Eat, baby. I alr—", "cut": { "word": 3, "frac": 0.45 }, "gapAfter": 0.08 },
      { "say": "LILY", "text": "I already ate, Mom.", "cue": "goldcrack", "after": 0.8 }
    ]},
    { "id": "ending", "items": [
      { "say": "N", "text": "It was the first lie Lily ever told." },
      { "say": "N", "text": "Because in this world, the people with the most cracks..." },
      { "say": "N", "text": "are the ones who love you most.", "after": 1.2 }
